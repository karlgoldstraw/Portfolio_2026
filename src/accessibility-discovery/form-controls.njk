              </span>
              <span class="date-part">
                <label for="ff-month">Month</label>
                <input type="text" inputmode="numeric" id="ff-month" name="month"
                       autocomplete="bday-month" aria-describedby="ff-dob-hint">
              </span>
              <span class="date-part date-part--year">
                <label for="ff-year">Year</label>
                <input type="text" inputmode="numeric" id="ff-year" name="year"
                       autocomplete="bday-year" aria-describedby="ff-dob-hint">
              </span>
            </div>
          </fieldset>

          <div class="field">
            <label for="ff-address">Address</label>
            <span class="hint" id="ff-address-hint">House number or name, street and town.</span>
            <p class="field-error" id="ff-address-error" hidden></p>
            <input type="text" id="ff-address" name="address" autocomplete="street-address"
