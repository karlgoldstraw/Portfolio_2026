          </div>

          <div class="field">
            <label for="ff-postcode">Postcode</label>
            <span class="hint" id="ff-postcode-hint">With or without a space, for example SA1 5LN.</span>
            <p class="field-error" id="ff-postcode-error" hidden></p>
            <input type="text" id="ff-postcode" name="postcode" autocomplete="postal-code"
                   aria-describedby="ff-postcode-hint" class="input--short">
          </div>

          <div class="field">
            <label for="ff-phone">Contact number (optional)</label>
            <span class="hint" id="ff-phone-hint">We will only use this if we have a question about your move.</span>
            <input type="tel" id="ff-phone" name="phone" autocomplete="tel"
                   aria-describedby="ff-phone-hint">
          </div>

          <p>
            <button type="submit" class="btn">Submit</button>
          </p>
        </form>
      </div>
      <p class="tally">Attempts: <strong id="fixed-attempts">0</strong></p>
