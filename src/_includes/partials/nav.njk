<nav class="navigation" aria-label="Main">
  {%- if page.url == "/" %}
  <a class="site-name active" aria-current="page" href="/">{{ site.author }}</a>
  {%- else %}
  <a class="site-name" href="/">{{ site.author }}</a>
  {%- endif %}
  <ul>
    {%- for entry in collections.all | eleventyNavigation %}
    {%- if entry.url == page.url %}
    <li><a class="active" aria-current="page" href="{{ entry.url }}">{{ entry.title }}</a></li>
    {%- elif entry.url != "/" and page.url and page.url.startsWith(entry.url) %}
    <li><a class="active" href="{{ entry.url }}">{{ entry.title }}</a></li>
    {%- else %}
    <li><a href="{{ entry.url }}">{{ entry.title }}</a></li>
    {%- endif %}
    {%- endfor %}
  </ul>
</nav>
