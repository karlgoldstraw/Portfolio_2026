<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {%- if noindex %}
  <meta name="robots" content="noindex">
  {%- endif %}
  <title>{% if title %}{{ title }} | {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  <meta property="og:title" content="{{ title or site.title }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:type" content="{% if layout == 'layouts/post.njk' %}article{% else %}website{% endif %}">

  <link rel="icon" href="/assets/img/favicon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500&display=swap">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="alternate" type="application/atom+xml" href="/feed.xml" title="{{ site.title }}">
</head>

<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
<a class="skiplinks" href="#main">Skip to main content</a>
<div class="wrapper">

  <header>
    {% include "partials/nav.njk" %}
    {% block header %}{% endblock %}
  </header>

  <main id="main"{% block mainAttrs %}{% endblock %}>
    {% block main %}{{ content | safe }}{% endblock %}
  </main>

  {% include "partials/footer.njk" %}
</div>
</body>
</html>
