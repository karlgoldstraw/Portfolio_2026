---
bodyClass: post
---
{% extends "layouts/base.njk" %}

{% block header %}
<h1 id="page-h1">{{ title }}.</h1>
<p class="date"><time datetime="{{ page.date | htmlDateString }}">{{ page.date | readableDate }}</time>{% if draft %} (draft){% endif %}</p>
{%- set postTags = tags | filterTagList %}
{%- if postTags.length %}
<ul class="tag_list">
  {%- for tag in postTags %}
  <li>{{ tag }}</li>
  {%- endfor %}
</ul>
{%- endif %}
<hr>
{% endblock %}

{% block mainAttrs %} aria-labelledby="page-h1"{% endblock %}

{% block main %}
<article class="prose post">
  {{ content | safe }}

  <a href="/design-snippets/" class="back-arrow">
    <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M4.1 12.3l2.7 3c.2.2.5.2.7 0 .1-.1.1-.2.1-.3v-2h11c.6 0 1-.4 1-1s-.4-1-1-1h-11V9c0-.2-.1-.4-.3-.5h-.2c-.1 0-.3.1-.4.2l-2.7 3c0 .2 0 .4.1.6z"></path></svg> <span class="arrow-text">Return to Design snippets</span>
  </a>
</article>
{% endblock %}
