{% extends "layouts/base.njk" %}

{% block head %}
<link rel="stylesheet" href="/css/discovery.css">
{% endblock %}

{% block header %}
<p class="eyebrow"><a href="/accessibility-discovery/">Accessibility discovery</a></p>
<h1 id="page-h1">{{ title }}</h1>
<hr>
{% endblock %}

{% block mainAttrs %} aria-labelledby="page-h1"{% endblock %}

{% block main %}
<article class="prose exercise">

  <section class="brief" aria-labelledby="brief-heading">
    <h2 id="brief-heading">The scenario</h2>
    <p>{{ scenario | safe }}</p>

    <h3>Your task</h3>
    {% if tasks %}
    <ol class="brief__tasks">
      {%- for item in tasks %}
      <li>{{ item | safe }}</li>
      {%- endfor %}
    </ol>
    {% else %}
    <p>{{ task | safe }}</p>
    {% endif %}

    <dl class="brief__meta">
      <div>
        <dt>Time</dt>
        <dd>{{ time or "5 minutes" }}</dd>
      </div>
      <div>
        <dt>Barrier</dt>
        <dd>{{ barrier }}</dd>
      </div>
      <div>
        <dt>Success criterion</dt>
        <dd>{{ criterion | safe }}</dd>
      </div>
    </dl>
  </section>

  {{ content | safe }}

  <nav class="exercise-nav" aria-label="Exercises">
    <a href="/accessibility-discovery/" class="back-arrow">
      <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M4.1 12.3l2.7 3c.2.2.5.2.7 0 .1-.1.1-.2.1-.3v-2h11c.6 0 1-.4 1-1s-.4-1-1-1h-11V9c0-.2-.1-.4-.3-.5h-.2c-.1 0-.3.1-.4.2l-2.7 3c0 .2 0 .4.1.6z"></path></svg> <span class="arrow-text">All exercises</span>
    </a>
    {%- set ordered = collections.exercises %}
    {%- for item in ordered %}
      {%- if item.url == page.url and ordered[loop.index0 + 1] %}
      <a href="{{ ordered[loop.index0 + 1].url }}" class="next-link">Next: {{ ordered[loop.index0 + 1].data.title }}</a>
      {%- endif %}
    {%- endfor %}
  </nav>
</article>
{% endblock %}

{% block scripts %}
<script src="/js/discovery/common.js" defer></script>
{%- if script %}
<script src="/js/discovery/{{ script }}" defer></script>
{%- endif %}
{% endblock %}
